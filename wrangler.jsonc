{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fio-import",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fio-import",
      "database_id": "c082caa7-9624-43b3-bf77-7f1c5e8db94c"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "vars": {
    "ACCOUNT_FROM": "2401442781",
    "ACCOUNT_TO": "2900203312",
    "BANK_CODE": "2010",
    "PAYMENT_TYPE": "431001",
    "AI_PROVIDER": "workers-ai"
  }
}
